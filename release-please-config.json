{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-v-in-tag": true,
  "plugins": ["node-workspace"],
  "packages": {
    "packages/catcher-core-ts": {
      "package-name": "@eric8810/catcher-core"
    },
    "packages/catcher-http-ts": {
      "package-name": "@eric8810/catcher-http"
    },
    "packages/catcher-ws-ts": {
      "package-name": "@eric8810/catcher-ws"
    },
    "packages/catcher-web": {
      "package-name": "@eric8810/catcher-web"
    },
    "packages/catcher-napi-http": {
      "package-name": "@eric8810/catcher-napi-http"
    },
    "packages/catcher-napi-ws": {
      "package-name": "@eric8810/catcher-napi-ws"
    },
    "packages/catcher-core": {
      "package-name": "catcher-core",
      "release-type": "rust"
    },
    "packages/catcher-dns": {
      "package-name": "catcher-dns",
      "release-type": "rust"
    },
    "packages/catcher-http": {
      "package-name": "catcher-http",
      "release-type": "rust"
    },
    "packages/catcher-ws": {
      "package-name": "catcher-ws",
      "release-type": "rust"
    },
    "packages/catcher-ffi": {
      "package-name": "catcher-ffi",
      "release-type": "rust"
    },
    "packages/catcher-uniffi": {
      "package-name": "catcher-uniffi",
      "release-type": "rust"
    },
    "packages/catcher_core": {
      "package-name": "catcher_core",
      "release-type": "dart",
      "extra-files": [
        "ios/catcher_core.podspec",
        "macos/catcher_core.podspec"
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features", "hidden": false },
    { "type": "fix", "section": "Bug Fixes", "hidden": false },
    { "type": "perf", "section": "Performance Improvements", "hidden": false },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "CI/CD", "hidden": true }
  ]
}
