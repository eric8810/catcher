{
  "name": "@eric8810/catcher-http",
  "version": "0.1.0",
  "description": "Catcher HTTP client — resilient transport with retry, circuit breaker, priority scheduling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@eric8810/catcher-core": "workspace:*",
    "cacheable-lookup": "^7.0.0",
    "cockatiel": "^3.0.0",
    "p-queue": "^8.0.0",
    "p-retry": "^6.0.0"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "axios": { "optional": true }
  },
  "devDependencies": {
    "@eric8810/catcher-core": "workspace:*",
    "axios": "^1.11.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
