{
  "name": "@eric8810/catcher-web",
  "version": "0.3.15",
  "description": "Catcher HTTP client for browsers — fetch-based with retry, circuit breaker & priority queue",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@eric8810/catcher-core": "workspace:*",
    "cockatiel": "^3.0.0",
    "p-retry": "^6.0.0",
    "p-queue": "^8.0.0"
  },
  "license": "MIT"
}
