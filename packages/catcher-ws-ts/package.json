{
  "name": "@eric8810/ws",
  "version": "0.1.0",
  "description": "Catcher WebSocket client — resilient reconnect, multi-endpoint racing, msgpack codec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@eric8810/core": "workspace:*"
  },
  "peerDependencies": {
    "msgpackr": "^1.10.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "msgpackr": { "optional": true },
    "ws": { "optional": true }
  },
  "devDependencies": {
    "@eric8810/core": "workspace:*",
    "@types/ws": "^8.0.0",
    "msgpackr": "^1.10.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
