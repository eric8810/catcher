{
  "name": "catcher-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:ts": "pnpm --filter @catcher/core --filter @catcher/http --filter @catcher/ws --filter @catcher/web build",
    "test": "vitest run",
    "test:integration": "vitest run packages/test/integration",
    "test:e2e": "vitest run packages/test/e2e",
    "test:chaos": "vitest run packages/test/chaos",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
